# Required for Gemini AI API calls. Keep this server-side; never prefix with VITE_.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Stable Gemini API model IDs (verify availability for your Google AI project).
GEMINI_PRIMARY_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.5-flash-lite"

# Required in production for distributed AI/code-run rate limiting.
# Server-only secrets; never prefix with VITE_.
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"
