{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run generate:pdf && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "generate:pdf": "node scripts/generate_code_pdf_v2.cjs",
    "lint": "tsc --noEmit",
    "test:tools": "node scripts/verify-tools.mjs",
    "test:repair": "node scripts/repair-smoke-tests.mjs",
    "test:quality": "tsx scripts/quality-tool-smoke.ts",
    "test:runtime": "tsx scripts/runtime-tool-smoke.ts",
    "test:static": "npx playwright test --config=playwright.static-audit.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfkit": "^0.20.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  }
}
